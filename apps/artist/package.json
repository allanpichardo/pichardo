{
  "name": "@pichardo/artist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "build": "pnpm generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "payload": "payload",
    "generate": "payload generate:types && payload generate:importmap",
    "bootstrap": "payload run src/scripts/bootstrap.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "media:worker": "payload run src/scripts/media-worker.ts",
    "media:reprocess": "payload run src/scripts/media-reprocess.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.93.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "@payloadcms/ui": "3.93.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  }
}
