# Development schema push is enabled only under NODE_ENV=development.
# Set false when rehearsing migrations against a separate database.
PAYLOAD_DB_PUSH=true
# Supply only when running pnpm bootstrap. Do not commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=
