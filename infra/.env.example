# Copy to infra/.env and restrict its permissions to 600.
# Replace revision with the full Git revision used to build both image targets.
ARTIST_IMAGE=pichardo-artist:revision
ARTIST_WORKER_IMAGE=pichardo-artist-tools:revision
PROFESSIONAL_IMAGE=pichardo-professional:revision
ARTIST_PORT=3000
PROFESSIONAL_PORT=3001
ARTIST_URL=https://allanpichardo.com
PROFESSIONAL_URL=https://pichardo.dev
POSTGRES_USER=payload
POSTGRES_DB=artist
# Use openssl rand -hex 32. Hex avoids URL-encoding issues in DATABASE_URL.
POSTGRES_PASSWORD=
# Generate a different value with openssl rand -hex 32.
PAYLOAD_SECRET=
# Create this existing absolute directory with owner 1001:1001 and mode 750.
MEDIA_HOST_DIR=/srv/pichardo/media
